{
    "name": "pkg-unpacker",
    "version": "3.1.0",
    "description": "Unpack pkg, nexe, caxa, Node.js SEA and Bun single-file binaries",
    "private": true,
    "type": "module",
    "module": "src/index.ts",
    "bin": {
        "pkg-unpacker": "./src/main.ts"
    },
    "main": "dist-node/index.js",
    "exports": {
        ".": "./dist-node/index.js",
        "./dispatch": "./dist-node/dispatch.js",
        "./pkg/unpacker": "./dist-node/pkg/unpacker.js",
        "./sea/unpacker": "./dist-node/sea/unpacker.js",
        "./bun/unpacker": "./dist-node/bun/unpacker.js",
        "./nexe/unpacker": "./dist-node/nexe/unpacker.js",
        "./caxa/unpacker": "./dist-node/caxa/unpacker.js"
    },
    "author": "LockBlock-dev",
    "license": "MIT",
    "scripts": {
        "start": "bun src/main.ts",
        "start:node": "node dist-node/main.js",
        "build": "bun build ./src/main.ts --outdir ./dist --target bun",
        "build:node": "tsc -p tsconfig.node.json",
        "compile": "bun build ./src/main.ts --compile --outfile pkg-unpacker",
        "test": "bun test",
        "typecheck": "bun check",
        "typecheck:node": "tsc -p tsconfig.node.json --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LockBlock-dev/pkg-unpacker.git"
    },
    "dependencies": {
        "commander": "^15.0.0"
    },
    "devDependencies": {
        "@types/bun": "^1.4.3",
        "@types/node": "^26.6.5",
        "typescript": "^7.0.2"
    }
}
