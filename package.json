{
    "name": "pkg-unpacker",
    "version": "2.2.0",
    "description": "Unpack any pkg application",
    "private": true,
    "type": "module",
    "module": "src/main.ts",
    "author": "LockBlock-dev",
    "license": "MIT",
    "scripts": {
        "start": "bun src/main.ts",
        "build": "bun build ./src/main.ts --outdir ./dist --target bun",
        "compile": "bun build ./src/main.ts --compile --outfile pkg-unpacker",
        "test": "bun test",
        "typecheck": "bun check"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LockBlock-dev/pkg-unpacker.git"
    },
    "dependencies": {
        "commander": "^15.0.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "^7.0.2"
    }
}
